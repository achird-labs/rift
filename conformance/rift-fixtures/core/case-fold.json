    {
      "predicates": [{ "contains": { "body": "naïve" }, "caseSensitive": false }],
      "responses": [{ "is": { "statusCode": 200, "body": "co" } }]
    },
    {
      "predicates": [{ "endsWith": { "body": "élan" }, "caseSensitive": false }],
      "responses": [{ "is": { "statusCode": 200, "body": "ew" } }]
