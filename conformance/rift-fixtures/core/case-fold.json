{
  "protocol": "http",
  "name": "core · ASCII-only case folding (rift#480)",
  "stubs": [
    {
      "predicates": [{ "startsWith": { "body": "café" }, "caseSensitive": false }],
      "responses": [{ "is": { "statusCode": 200, "body": "sw" } }]
