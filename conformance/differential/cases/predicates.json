{
  "source": "tests/compatibility/features/predicates.feature (retired in #1341)",
  "cases": [
    {
      "name": "predicates: Equals predicate matches exact path",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/exact/path"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "matched"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/exact/path"
        }
      ]
    },
