{
  "source": "tests/compatibility/features/stub_management.feature (retired in #1341)",
  "cases": [
    {
      "name": "stub_management: First matching stub is used when multiple stubs could match",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [
                  {
                    "startsWith": {
                      "path": "/api"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "general api"
                    }
                  }
                ]
              },
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/api/users"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "specific users"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/api/users"
        }
      ]
    },
    {
      "name": "stub_management: More specific stub matches when placed first",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/api/users"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "specific users"
                    }
                  }
                ]
              },
              {
                "predicates": [
                  {
                    "startsWith": {
                      "path": "/api"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "general api"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/api/users"
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/api/orders"
        }
      ]
    },
    {
      "name": "stub_management: Stubs with same path but different methods work independently",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/resource",
                      "method": "GET"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "GET response"
                    }
                  }
                ]
              },
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/resource",
                      "method": "POST"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 201,
                      "body": "POST response"
                    }
                  }
                ]
              },
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/resource",
                      "method": "DELETE"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 204,
                      "body": ""
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/resource"
        }
      ]
    },
    {
      "name": "stub_management: Duplicate predicates are allowed - first wins",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/test"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "first"
                    }
                  }
                ]
              },
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/test"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "second"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/test"
        }
      ]
    },
    {
