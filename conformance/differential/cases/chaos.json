          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "responses": [
                  {
                    "is": {},
                    "behaviors": [
                      {
                        "chaos": {}
                      },
                      {
                        "chaos": {
                          "bogus": 1
                        }
                      },
                      {
                        "chaos": "x"
                      },
                      {
