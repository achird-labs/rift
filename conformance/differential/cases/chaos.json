    {
      "name": "chaos: the _behaviors object form ignores chaos, invalid or not",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/invalid"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "body": "ok"
                    },
                    "_behaviors": {
                      "chaos": {
                        "errorRate": "x"
                      }
                    }
                  }
                ]
              },
              {
                "responses": [
                  {
                    "is": {
                      "body": "ok"
                    },
                    "_behaviors": {
                      "chaos": {
                        "errorRate": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/invalid"
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/valid"
        }
      ]
    },
    {
      "name": "chaos: an injected error serves the defaultResponse body",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "defaultResponse": {
              "body": "fallback"
            },
            "stubs": [
              {
                "responses": [
                  {
                    "is": {
                      "body": "ok"
                    },
                    "behaviors": [
                      {
                        "chaos": {
                          "errorRate": 1,
                          "errorStatusCode": 503
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/"
        }
