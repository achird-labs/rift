      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "name": "Test Imposter"
          }
        },
        {
          "do": "admin",
          "method": "GET",
          "path": "/imposters/4545"
        }
      ]
    },
