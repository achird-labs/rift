    {
      "name": "alternative_formats: StatusCode as string in response",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/string-status"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": "200",
                      "body": "status code was string"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/string-status"
        }
      ]
