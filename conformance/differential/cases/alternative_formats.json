    {
      "name": "alternative_formats: Complex real-world format with all alternative features",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "allowCORS": true,
            "protocol": "http",
            "port": 4545,
            "stubs": [
              {
                "scenarioName": "LenderDetails-v1-lenders_test",
                "predicates": [
                  {
                    "equals": {
                      "query": {
                        "lenderIds": "TEST123"
                      }
                    }
                  },
                  {
                    "deepEquals": {
                      "method": "GET"
                    }
                  }
                ],
                "responses": [
                  {
                    "behaviors": [
                      {
                        "wait": " function() { var min = Math.ceil(0); var max = Math.floor(0); var num = Math.floor(Math.random() * (max - min + 1)); var wait = (num + min); return wait; } "
                      }
                    ],
                    "is": {
                      "statusCode": "200",
                      "headers": {
                        "Accept": "application/json",
                        "Content-Type": "application/json"
                      },
                      "body": "{\"lenders\": [{\"lenderId\": \"TEST123\"}]}"
                    },
                    "proxy": null
                  }
                ]
              }
            ],
            "service_name": "LenderDetails_v1_lenders"
          }
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/?lenderIds=TEST123"
        }
      ]
    },
