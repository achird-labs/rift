{
  "source": "tests/compatibility/features/proxy.feature (retired in #1341)",
  "cases": [
    {
      "name": "proxy: Basic proxy forwards requests to backend",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4546,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "backend response"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "responses": [
                  {
                    "proxy": {
                      "to": "http://localhost:4546"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/api/test"
        }
      ]
    },
