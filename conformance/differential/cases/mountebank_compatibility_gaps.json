{
  "source": "tests/compatibility/features/mountebank_compatibility_gaps.feature (retired in #1341)",
  "cases": [
    {
      "name": "mountebank_compatibility_gaps: removeProxies filters proxy stubs from single imposter response",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/static"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "static response"
                    }
                  }
                ]
              },
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/proxy"
                    }
                  }
                ],
                "responses": [
                  {
                    "proxy": {
                      "to": "http://example.com"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "admin",
          "method": "GET",
          "path": "/imposters/4545?removeProxies=true"
        }
      ]
    },
    {
      "name": "mountebank_compatibility_gaps: removeProxies filters proxy stubs from all imposters response",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/static"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "static"
                    }
                  }
                ]
              },
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/proxy"
                    }
                  }
                ],
                "responses": [
                  {
                    "proxy": {
                      "to": "http://example.com"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "admin",
          "method": "GET",
          "path": "/imposters?replayable=true&removeProxies=true"
        }
      ]
    },
    {
      "name": "mountebank_compatibility_gaps: Binary mode decodes base64 body",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [
                  {
                    "equals": {
                      "path": "/binary"
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "headers": {
                        "Content-Type": "application/octet-stream"
                      },
                      "body": "SGVsbG8gV29ybGQh",
                      "_mode": "binary"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/binary"
        }
      ]
    },
    {
      "name": "mountebank_compatibility_gaps: Text mode (default) returns body as-is",
