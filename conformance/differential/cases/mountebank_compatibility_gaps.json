    },
    {
      "name": "mountebank_compatibility_gaps: Form predicate matches URL-encoded form data",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [
                  {
                    "equals": {
                      "form": {
                        "username": "admin",
                        "password": "secret"
                      }
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "form matched"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "method": "POST",
          "headers": [
            [
              "Content-Type",
              "application/x-www-form-urlencoded"
            ]
          ],
          "body": "username=admin&password=secret"
        }
      ]
    },
    {
      "name": "mountebank_compatibility_gaps: Form predicate with contains operator",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [
                  {
                    "contains": {
                      "form": {
                        "email": "@example.com"
                      }
                    }
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "email matched"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "method": "POST",
          "headers": [
            [
              "Content-Type",
              "application/x-www-form-urlencoded"
            ]
          ],
          "body": "email=user@example.com&name=Test"
        }
      ]
    },
    {
      "name": "mountebank_compatibility_gaps: keyCaseSensitive false allows case-insensitive header keys",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [
                  {
                    "equals": {
                      "headers": {
                        "X-CUSTOM-HEADER": "value"
                      }
                    },
                    "caseSensitive": false,
                    "keyCaseSensitive": false
                  }
                ],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "header matched"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "headers": [
            [
              "x-custom-header",
              "value"
            ]
          ]
        }
      ]
    },
