    {
      "name": "responses: Copy behavior with JSONPath extraction",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "User: ${USER_NAME}"
                    },
                    "_behaviors": {
                      "copy": {
                        "from": "body",
                        "into": "${USER_NAME}",
                        "using": {
                          "method": "jsonpath",
                          "selector": "$.user.name"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "method": "POST",
          "headers": [
            [
              "Content-Type",
              "application/json"
            ]
          ],
          "body": "{\"user\": {\"name\": \"Alice\"}}"
        }
      ]
    },
    {
