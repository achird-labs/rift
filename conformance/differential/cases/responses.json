    {
      "name": "responses: Copy behavior copies from request",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "headers": {
                        "X-Request-Id": "${REQUEST_ID}"
                      },
                      "body": "copied"
                    },
                    "_behaviors": {
                      "copy": {
                        "from": {
                          "headers": "X-Request-Id"
                        },
                        "into": "${REQUEST_ID}",
                        "using": {
                          "method": "regex",
                          "selector": ".*"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "headers": [
            [
              "X-Request-Id",
              "abc123"
            ]
          ]
        }
      ]
