    {
      "name": "responses: Decorate behavior adds custom headers",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "test"
                    },
                    "_behaviors": {
                      "decorate": "function(request, response) { response.headers = response.headers || {}; response.headers['X-Request-Path'] = request.path; }"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "path": "/decorated"
        }
      ]
    },
    {
      "name": "responses: Decorate behavior modifies status code conditionally",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "test"
                    },
                    "_behaviors": {
                      "decorate": "function(request, response) { var h = request.headers['x-force-error'] || request.headers['X-Force-Error']; if (h) { response.statusCode = 500; response.body = 'Forced error'; } }"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "do": "send",
          "port": 4545,
          "headers": [
            [
              "X-Force-Error",
              "true"
            ]
          ]
        }
      ]
    },
