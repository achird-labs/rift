    {
      "name": "responses: Lookup behavior basic structure is accepted",
      "steps": [
        {
          "do": "admin",
          "method": "POST",
          "path": "/imposters",
          "body": {
            "port": 4545,
            "protocol": "http",
            "stubs": [
              {
                "predicates": [],
                "responses": [
                  {
                    "is": {
                      "statusCode": 200,
                      "body": "User: ${row}['name']"
                    },
                    "_behaviors": {
                      "lookup": {
                        "key": {
                          "from": {
                            "query": "id"
                          },
                          "using": {
                            "method": "regex",
                            "selector": ".*"
                          }
                        },
                        "fromDataSource": {
